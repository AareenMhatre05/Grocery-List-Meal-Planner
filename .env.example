# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Restart `npm start` after editing it.

# Firebase web app config: Firebase console > Project settings > Your apps > Web app
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# data.gov.in (Government of India Open Data), for mandi market prices on the grocery list.
# Free: sign in at https://www.data.gov.in and copy the key from My Account.
REACT_APP_DATAGOV_KEY=

# Spoonacular recipe API (optional, not used yet). Free key: https://spoonacular.com/food-api/console
REACT_APP_SPOONACULAR_KEY=
